{
  "name": "lanhu-mcp",
  "version": "0.2.16",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/sync-plugin.mjs",
    "dev": "node scripts/dev.mjs",
