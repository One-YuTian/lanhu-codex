    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@openai/mcp-extensions": "0.2.0",
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "sharp": "0.34.5"
  }
}
